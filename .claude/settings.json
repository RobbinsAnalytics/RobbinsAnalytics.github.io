{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git add*)",
      "Bash(git restore*)",
      "Bash(git commit*)",
      "Bash(git push origin main)",
      "Bash(quarto render*)",
      "Bash(gh run*)",
      "Bash(curl -sSI*)",
      "Bash(curl -sS https://www.robbinsanalytics.com*)"
    ],
    "ask": [
      "Bash(git push*--force*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(quarto publish*)"
    ],
    "deny": [
      "Bash(git push*--force*origin main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/no_whitespace_commits.py\""
          }
        ]
      }
    ]
  }
}
