{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git branch*)",
      "Bash(git restore*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(quarto render*)",
      "Bash(gh run*)",
      "Bash(gh api repos/*/pages*)",
      "Bash(curl -sSI*)",
      "Bash(curl -sS https://www.robbinsanalytics.com*)",
      "Bash(curl -sSI https://www.robbinsanalytics.com*)",
      "Bash(curl -sS https://robbinsanalytics.com*)",
      "Bash(curl -sS https://robbinsanalytics.github.io*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(quarto publish*)"
    ],
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(git add . *)"
    ]
  },
  "defaultMode": "acceptEdits",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/no_blanket_add_or_force_push.py\""
          }
        ]
      }
    ]
  }
}
